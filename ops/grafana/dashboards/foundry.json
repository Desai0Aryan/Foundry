        "type": "prometheus",
        "uid": "foundry-prom"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(foundry_job_end_to_end_seconds_bucket[$__rate_interval])))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "foundry-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
