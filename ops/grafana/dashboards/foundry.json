    {
      "id": 11,
      "type": "timeseries",
      "title": "Attempt failure rate",
      "description": "Share of attempts that failed (and were retried or dead-lettered).",
      "datasource": {
        "type": "prometheus",
        "uid": "foundry-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(foundry_jobs_finished_total{outcome=~\"retry|dead\"}[$__rate_interval])) / sum(rate(foundry_jobs_finished_total{outcome=~\"succeeded|retry|dead\"}[$__rate_interval]))",
          "legendFormat": "failed attempts / all attempts",
          "datasource": {
            "type": "prometheus",
            "uid": "foundry-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
