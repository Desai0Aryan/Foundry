    {
      "id": 22,
      "type": "timeseries",
      "title": "Duplicate deliveries dropped",
      "description": "Harmless by design: the claim step discards messages for jobs that are not claimable.",
      "datasource": {
        "type": "prometheus",
        "uid": "foundry-prom"
      },
      "gridPos": {
        "x": 8,
        "y": 40,
        "w": 8,
