      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(foundry_duplicate_deliveries_total[$__rate_interval]))",
          "legendFormat": "dropped messages/s",
          "datasource": {
            "type": "prometheus",
            "uid": "foundry-prom"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(foundry_worker_lease_lost_total[$__rate_interval]))",
